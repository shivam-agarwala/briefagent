# ---------------------------------------------------------------------------
# Pick ONE provider.
# ---------------------------------------------------------------------------

# Option A: Gemini. Free tier, no credit card, no billing setup.
# Get a key at https://aistudio.google.com -> Get API key.
# This is the right choice if you are not paying for API credits.
BRIEFAGENT_PROVIDER=gemini
GEMINI_API_KEY=
BRIEFAGENT_MODEL=gemini-3.8-flash

# Option B: Anthropic. Paid, prepaid credits, no free tier.
# Get a key at https://console.anthropic.com -> Settings -> API keys.
# BRIEFAGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# BRIEFAGENT_MODEL=claude-sonnet-5-5

# Run `python -m briefagent.agent --list-models` to see what your key can
# actually use, then `--check` to confirm it works. Model names go stale:
# Google retired gemini-2.5-flash for new keys and returns a 404 naming its
# replacement. Nothing here is hardcoded in source for that reason.

# ---------------------------------------------------------------------------
# Pacing
# ---------------------------------------------------------------------------

# Minimum seconds between model calls. Free tiers cap requests per minute and
# the agent loop fires calls back to back. Defaults to 6.5 for Gemini (roughly
# 10 requests per minute) and 0 for Anthropic. Set 0 to disable.
# BRIEFAGENT_LLM_MIN_INTERVAL=6.5

# Timeout for one model call, seconds. Without this the Gemini SDK waits
# forever and a rate limited call looks like a frozen program.
# BRIEFAGENT_LLM_TIMEOUT=90

# Thinking tokens, for models that support it. 0 is off, -1 is automatic.
# Off by default: thinking tokens count against the output budget on Gemini
# 3.x, so a thinking model can spend the whole budget reasoning and return no
# tool call at all.
# BRIEFAGENT_THINKING_BUDGET=0

# ---------------------------------------------------------------------------
# Cost estimation
# ---------------------------------------------------------------------------

# Leave BOTH unset on a free tier. Cost then reports as 0 and the trace marks
# cost_priced: false, which is honest. Set them only when you are actually
# paying, using the current published price per million tokens.
BRIEFAGENT_PRICE_IN_PER_MTOK=
BRIEFAGENT_PRICE_OUT_PER_MTOK=

# ---------------------------------------------------------------------------
# Loop limits
# ---------------------------------------------------------------------------

BRIEFAGENT_MAX_TOOL_CALLS=6
BRIEFAGENT_MAX_STEPS=10
BRIEFAGENT_FETCH_CHAR_CAP=6000
BRIEFAGENT_BUDGET_MAX_TOKENS=60000
